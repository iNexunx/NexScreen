# AOSP testkey intermediates (public key, kept out of the tree for tidiness).
# keystore/aosp-testkey.p12 IS committed on purpose: the AOSP test key is
# published by Google and is public knowledge, so it carries no secret.
*.pk8
keystore/testkey.key

